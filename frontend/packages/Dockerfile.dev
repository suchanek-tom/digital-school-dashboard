FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
COPY admin-panel/package.json admin-panel/package.json
COPY display-client/package.json display-client/package.json

# Regenerate the incomplete lockfile inside the image to include native dependencies.
RUN rm package-lock.json && npm install --package-lock-only --ignore-scripts && npm ci

COPY admin-panel/ admin-panel/
COPY display-client/ display-client/

EXPOSE 3000

CMD ["npm", "run", "dev", "--workspace=admin-panel", "--", "--host", "0.0.0.0", "--port", "3000", "--strictPort"]
